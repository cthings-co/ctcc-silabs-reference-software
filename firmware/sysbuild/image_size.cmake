# Reserve the extra erase sector required by MCUboot swap-with-offset.
if(SB_CONFIG_BOOTLOADER_MCUBOOT)
  sysbuild_get(mcuboot_footer IMAGE mcuboot
    VAR mcuboot_image_footer_size CACHE)

  if("${mcuboot_footer}" STREQUAL "")
    message(FATAL_ERROR "Cannot determine MCUboot image footer size")
  endif()

  # MGM240P flash erase sector: 8 KiB.
  math(EXPR corrected_footer "${mcuboot_footer} + 0x2000"
    OUTPUT_FORMAT HEXADECIMAL)

  # Retrieve the configuration generated by MCUboot.
  get_property(image_config TARGET ${ZCMAKE_APPLICATION} PROPERTY CONFIG)

  # Require exactly one existing ROM_END_OFFSET assignment.
  string(REGEX MATCHALL
    "(^|\n)CONFIG_ROM_END_OFFSET=[^\n]*"
    existing_entries
    "${image_config}"
  )

  list(LENGTH existing_entries entry_count)

  if(NOT entry_count EQUAL 1)
    message(FATAL_ERROR
      "Expected exactly one MCUboot ROM_END_OFFSET assignment, found ${entry_count}")
  endif()

  # Replace the original assignment instead of appending a duplicate.
  string(REGEX REPLACE
    "(^|\n)CONFIG_ROM_END_OFFSET=[^\n]*"
    "\\1CONFIG_ROM_END_OFFSET=${corrected_footer}"
    image_config
    "${image_config}"
  )

  set_property(TARGET ${ZCMAKE_APPLICATION}
    PROPERTY CONFIG "${image_config}"
  )

  message(STATUS "MGM240P ROM_END_OFFSET: ${corrected_footer}")
endif()
